{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
    "name": "Warehouse MVP — Stock Read APIs",
    "description": "Slice 3.3 smoke: seed adjustment → list/get balances → 404 missing → list movements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "01 Login as Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('accessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "02 Ensure category",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('categoryCode', `RD-CAT-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));",
              "pm.environment.set('categoryId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{categoryCode}}\",\n  \"name\": \"Stock Read Category\"\n}"
        },
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "03 Ensure product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('productSku', `RD-${Date.now()}`);"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));",
              "pm.environment.set('productId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"Read Widget\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"unit\": \"EA\",\n  \"reorderPoint\": \"5\"\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "04 Ensure warehouse",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('warehouseCode', `RD-WH-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));",
              "pm.environment.set('warehouseId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{warehouseCode}}\",\n  \"name\": \"Stock Read WH\"\n}"
        },
        "url": "{{baseUrl}}/warehouses"
      }
    },
    {
      "name": "05 Ensure location",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([200,201]).to.include(pm.response.code));",
              "pm.environment.set('locationId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"code\": \"BIN-R1\",\n  \"name\": \"Read Bin\",\n  \"parentLocationId\": \"\"\n}"
        },
        "url": "{{baseUrl}}/locations"
      }
    },
    {
      "name": "06 Seed adjust +3 FOUND",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idemKey', `rd-adj-${Date.now()}`);"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('movementId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idemKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"locationId\": \"{{locationId}}\",\n  \"quantityDelta\": \"3\",\n  \"reasonCode\": \"FOUND\",\n  \"note\": \"seed for read\"\n}"
        },
        "url": "{{baseUrl}}/stock/adjustments"
      }
    },
    {
      "name": "07 List balances by product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has row', () => pm.expect(body.data.length).to.be.at.least(1));",
              "pm.test('available', () => pm.expect(body.data[0].available).to.eql('3.0000'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stock/balances?productId={{productId}}&page=1&pageSize=20"
      }
    },
    {
      "name": "08 Get one balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('onHand', () => pm.expect(body.onHand).to.eql('3.0000'));",
              "pm.test('available', () => pm.expect(body.available).to.eql('3.0000'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stock/balances/{{productId}}/{{locationId}}"
      }
    },
    {
      "name": "09 Missing balance 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));",
              "pm.test('STOCK_BALANCE_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('STOCK_BALANCE_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stock/balances/{{productId}}/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "10 List movements",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has movement', () => pm.expect(body.data.length).to.be.at.least(1));",
              "pm.test('includes seed', () => pm.expect(body.data.some((m) => m.id === pm.environment.get('movementId'))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stock/movements?productId={{productId}}&locationId={{locationId}}&type=ADJUSTMENT"
      }
    },
    {
      "name": "11 Low stock filter includes seeded row",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('low stock hit', () => pm.expect(body.data.some((b) => b.productId === pm.environment.get('productId') && b.locationId === pm.environment.get('locationId'))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/stock/balances?productId={{productId}}&lowStock=true"
      }
    }
  ]
}
