{
  "info": {
    "_postman_id": "c0ffee00-auth-rbac-0001-warehouse-mvp",
    "name": "Warehouse MVP — Auth & RBAC",
    "description": "Smoke tests for Stage 2 auth: login, /me permissions, users:write, refresh rotate, logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 Login as Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns tokens', () => {",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "pm.environment.set('accessToken', body.accessToken);",
              "pm.environment.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "02 Get me (Admin permissions)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has users:write', () => {",
              "  pm.expect(body.permissions).to.be.an('array').that.includes('users:write');",
              "});",
              "pm.test('no passwordHash', () => {",
              "  pm.expect(body).to.not.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "03 Create Manager user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now();",
              "pm.environment.set('managerEmail', `manager+${stamp}@warehouse.local`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201 or 200', () => {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "const body = pm.response.json();",
              "pm.test('created Manager', () => {",
              "  pm.expect(body.role).to.eql('Manager');",
              "  pm.expect(body.email).to.eql(pm.environment.get('managerEmail'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\",\n  \"fullName\": \"Demo Manager\",\n  \"role\": \"Manager\"\n}"
        },
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "04 Login as Manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.environment.set('managerAccessToken', body.accessToken);",
              "pm.test('manager token present', () => {",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "05 Manager create user is forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));",
              "const body = pm.response.json();",
              "pm.test('AUTH_FORBIDDEN', () => {",
              "  pm.expect(body.code).to.eql('AUTH_FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerAccessToken}}"
          },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff-should-fail@warehouse.local\",\n  \"password\": \"Staff1234!\",\n  \"fullName\": \"Should Fail\",\n  \"role\": \"Staff\"\n}"
        },
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "06 Refresh rotates token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const oldRefresh = pm.environment.get('refreshToken');",
              "pm.test('new refresh differs', () => {",
              "  pm.expect(body.refreshToken).to.be.a('string').and.not.eql(oldRefresh);",
              "});",
              "pm.environment.set('oldRefreshToken', oldRefresh);",
              "pm.environment.set('accessToken', body.accessToken);",
              "pm.environment.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "07 Old refresh is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('AUTH_INVALID_REFRESH', () => {",
              "  pm.expect(body.code).to.eql('AUTH_INVALID_REFRESH');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "08 Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/logout"
      }
    }
  ]
}
