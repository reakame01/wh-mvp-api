# Copy to .env and fill in locally. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warehouse_mvp?schema=public

# JWT / refresh (replace with long random strings in real use)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-pepper-min-32-chars

# Seed admin (local/demo only — never commit real .env)
SEED_ADMIN_EMAIL=admin@warehouse.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!

# Redis (Tier 2+)
REDIS_URL=redis://localhost:6379

# RabbitMQ (Tier 2+)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AWS S3 (Tier 2+; leave empty until needed)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
